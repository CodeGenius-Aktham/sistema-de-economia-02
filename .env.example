# Copia este archivo como .env (o configura estas variables en tu hosting)

# Puerto del servidor
PORT=3000

# Carpeta donde se guardan la base de datos y los archivos subidos.
# En producción debe ser un disco persistente.
DATA_DIR=./data

# Credenciales del administrador que se crea la PRIMERA vez que arranca el sistema.
# Si no las defines, se usa admin / admin123 y el panel te pedirá cambiarla.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Tamaño máximo por archivo subido (MB)
MAX_UPLOAD_MB=50

# Si el portal está detrás de un proxy (Render, Railway, Nginx…), pon 1
TRUST_PROXY=1
