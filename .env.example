# Copia este archivo como .env para configurar el portal en tu computadora.
# En Vercel estas variables se ponen en: Project → Settings → Environment Variables.

# Usuario y contraseña del administrador (se crea la PRIMERA vez que arranca).
# Si no las defines: admin / admin123 y el panel te pedirá cambiarla.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- Solo para Vercel (o si quieres usar la nube desde tu computadora) ----
# Base de datos Turso: https://app.turso.tech → tu base → "Connect"
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob (privado) para los archivos. Vercel la agrega sola al conectar el Blob.
BLOB_READ_WRITE_TOKEN=

# ---- Opcionales ----
# Puerto local
PORT=3000
# Carpeta de la base de datos y archivos cuando NO usas Turso/Blob
DATA_DIR=./data
# Tamaño máximo por archivo en MB (por defecto 50 local, 100 en Vercel Blob)
MAX_UPLOAD_MB=
